rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testDoc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User's publications subcollection
      match /books/{bookId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(bookId);
      }
    }
  }
}
